# ==========================================
# Finovo Frontend Environment Variables (Vercel)
# ==========================================

# 1. URL of your deployed Vercel Backend REST API (e.g. https://your-backend.vercel.app)
# If using direct cross-domain API calls, set this. If using Vercel rewrites, this can be empty.
VITE_API_URL=https://your-backend.vercel.app

# 2. Local development server port
PORT=5173

# 3. Node environment
NODE_ENV=production
