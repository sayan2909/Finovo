# ==========================================
# Finovo Backend Environment Variables (Vercel)
# ==========================================

# 1. PostgreSQL Connection String (Required on Vercel: Supabase Pooler, Neon, or Railway)
# Note: Use Supabase Session/Transaction Pooler port (6543) or direct connection with ssl
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 2. JWT Signing Secret (Required - use a secure random string)
JWT_SECRET=finovo_jwt_super_secret_production_key_replace_this

# 3. Environment Mode
NODE_ENV=production

# 4. Optional: Cookie SameSite setting (Default on Vercel is 'none' for cross-domain auth)
COOKIE_SAME_SITE=none
